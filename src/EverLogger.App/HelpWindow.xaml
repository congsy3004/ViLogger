<Window x:Class="EverLogger.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViLogger — Help"
        Width="720" Height="620"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1F"
        Foreground="#E4E4E7"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <!-- Button name column -->
        <Style x:Key="BtnName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- Description column -->
        <Style x:Key="BtnDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- Row separator -->
        <Style x:Key="RowSep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#141417" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="14" Background="#1E3A5F" Margin="0,0,10,0">
                    <TextBlock Text="?" FontSize="15" FontWeight="Bold" Foreground="#60A5FA"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Button Reference" FontSize="15" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                    <TextBlock Text="Describes every control in ViLogger" FontSize="11" Foreground="#71717A"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
            <StackPanel>

                <!-- ══════════════ GLOBAL TOOLBAR ══════════════ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Global Toolbar"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnName}" Text="+ Add Port"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Add a new port monitoring panel (maximum 4). The available COM ports are automatically rescanned each time you press this. Layout adjusts automatically: 1 port = full width, 2 ports = side by side, 3 ports = three columns, 4 ports = 2×2 grid."/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnName}" Text="▶ Connect All"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Connect all port panels that have been configured (Apply Configuration clicked) but are not yet connected. Panels already connected are not affected."/>
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BtnName}" Text="▶ Log All  /  ■ Log All"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="▶ Log All (green) starts file logging on all configured ports simultaneously. ■ Log All (red) stops logging on all ports. Log files are saved in the configured Log Directory using the File Template naming scheme."/>
                    <Border Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource BtnName}" Text="Enter to send"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Toggles Enter key behaviour in all TX input boxes.&#10;• ON (green): pressing Enter immediately sends the current TX content.&#10;• OFF (red): pressing Enter inserts a CR character (\r). Pressing Enter again immediately after CR inserts LF (\n). LF is only added when the previous character is CR."/>
                    <Border Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource BtnName}" Text="? (this window)"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Opens this help window."/>
                </Grid>

                <!-- ══════════════ LOG DIRECTORY ROW ══════════════ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Log Directory Row"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnName}" Text="Log Directory"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="The folder where all log files are written. Shared across all ports. Type a path directly or use the ... browse button to pick a folder."/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnName}" Text="... (browse)"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Opens a folder picker dialog to select the log directory."/>
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BtnName}" Text="📁 Open Dir"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Opens the log directory in Windows File Explorer so you can browse the saved log files."/>
                </Grid>

                <!-- ══════════════ PORT CONFIGURATION CARD ══════════════ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Port Configuration Card  (shown before Apply)"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnName}" Text="COM Port"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Select the COM port to monitor. The list is refreshed automatically each time + Add Port is pressed."/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnName}" Text="Baud Rate"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Select the communication speed. Must match the speed configured on your MCU or device. Common values: 9600, 115200, 921600."/>
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BtnName}" Text="Data Bits"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Number of data bits per byte frame. Almost all modern devices use 8. Options: 5, 6, 7, 8."/>
                    <Border Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource BtnName}" Text="Parity"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Parity bit for basic error detection. None = no parity (most common). Even/Odd = one extra bit added so the total 1-bits are even or odd. Mark/Space = parity bit is always 1 or 0."/>
                    <Border Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource BtnName}" Text="Stop Bits"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Number of stop bits that mark the end of each byte. One = standard (most devices). OnePointFive / Two = used in older or specific industrial protocols."/>
                    <Border Grid.Row="9" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource BtnName}" Text="Handshake"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Flow control method. None = no flow control (most common for MCU UART). RTS/CTS = hardware handshake using dedicated signal lines. XOnXOff = software handshake using special ASCII characters (DC1/DC3)."/>
                    <Border Grid.Row="11" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource BtnName}" Text="Name"/>
                    <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Optional custom label for this port panel (e.g. &quot;GPS Module&quot;, &quot;IMU&quot;, &quot;Debug UART&quot;). Shown in the port header once configured."/>
                    <Border Grid.Row="13" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource BtnName}" Text="✓ Apply Configuration"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Locks in the selected settings and switches the panel to monitoring mode. Use the ↺ Reset button in the header to return to the configuration card."/>
                </Grid>

                <!-- ══════════════ CONFIGURED PORT HEADER ══════════════ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Configured Port Header"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnName}" Text="↺ (Reset)"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Returns the panel to the configuration card so settings can be changed. The port must be disconnected first — if connected, this button is disabled."/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnName}" Text="✕ (Close)"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Removes this port panel entirely. Disconnects and stops logging before closing. The last remaining panel cannot be closed."/>
                </Grid>

                <!-- ══════════════ PER-PORT CONTROLS TOOLBAR ══════════════ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Per-Port Controls Toolbar"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnName}" Text="Connected / Disconnected"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Toggles the connection state of this port. Green = connected and receiving data. Red = disconnected. If the device is physically unplugged while connected, the button automatically turns red and resets — click it again to reconnect once the device is plugged back in."/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnName}" Text="Log ON / Log OFF"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Toggles file logging for this port. Green (ON) = actively writing received data to a log file in the configured Log Directory. Red (OFF) = logging stopped. The log file stays open between sessions until the app closes."/>
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BtnName}" Text="View: (combobox)"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Controls how received bytes are displayed in the monitor. ASCII = human-readable text. Hex = raw hex bytes (e.g. 48 65 6C). Binary = show byte count only. Can be changed while connected without interrupting data."/>
                    <Border Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource BtnName}" Text="Log: (combobox)"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Controls the format written to the log file. Independent of the display format. ASCII writes readable text. Hex writes hex-encoded bytes. Binary writes raw bytes."/>
                    <Border Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource BtnName}" Text="TS ON / TS OFF"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Toggles per-line timestamps in the monitor. Green (ON) = each line is prefixed with [HH:mm:ss.fff]. Red (OFF) = lines are shown without timestamp. Default is ON. Does not affect the log file format."/>
                    <Border Grid.Row="9" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource BtnName}" Text="Auto↓ (checkbox)"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Auto-scroll: when checked, the terminal monitor automatically scrolls to the latest received line. Uncheck to freeze the view and scroll manually."/>
                    <Border Grid.Row="11" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource BtnName}" Text="Clear"/>
                    <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Clears the monitor display immediately. This does NOT affect the log file — all data already written to disk is preserved."/>
                </Grid>

                <!-- ══════════════ TX TRANSMIT BAR ══════════════ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="TX Transmit Bar"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnName}" Text="TX input box"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Type the text or hex bytes to transmit. In hex mode, enter space-separated bytes (e.g. 48 65 6C 6C 6F to send 'Hello'). Enter key behaviour is controlled by the global Enter to send toggle."/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnName}" Text="Hex (checkbox)"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="When checked, the TX input is interpreted as space-separated hexadecimal bytes. Example: '0D 0A' sends CRLF. When unchecked, input is sent as plain ASCII text."/>
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BtnName}" Text="Line ending (combobox)"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Bytes appended automatically after the TX content on every send: None = no extra bytes. CR = \r (0x0D). LF = \n (0x0A). CRLF = \r\n (0x0D 0x0A). Most terminals and MCU parsers expect CRLF or LF."/>
                    <Border Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource RowSep}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource BtnName}" Text="Send"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource BtnDesc}"
                               Text="Sends the TX input content to the serial port immediately. The selected line ending is appended automatically. Sent data is echoed in the monitor as 'TX>> ...' for confirmation. Only available when connected."/>
                </Grid>

                <Border Height="20"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Close button footer -->
        <Border Grid.Row="2" Background="#141417" BorderBrush="#2A2A30" BorderThickness="0,1,0,0" Padding="12,8">
            <Button Content="Close" Click="CloseButton_Click"
                    Width="80" Height="28" HorizontalAlignment="Right"
                    FontSize="11"/>
        </Border>
    </Grid>
</Window>
