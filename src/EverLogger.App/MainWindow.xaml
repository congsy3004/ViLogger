<Window x:Class="EverLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:EverLogger.App.Helpers"
        Title="ViLogger — Serial Monitor &amp; Logger" 
        Height="800" Width="1180"
        MinWidth="850" MinHeight="600"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource PrimaryForegroundBrush}"
        FontFamily="Segoe UI, Inter, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">
    
    <Window.Resources>
        <helpers:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <helpers:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,4,0"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="75"/>
        </Style>

        <Style x:Key="MetricPill" TargetType="Border">
            <Setter Property="Background" Value="#1C2333"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════ GENERAL CONFIG TOOLBAR ═══════════ -->
        <Border DockPanel.Dock="Top" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Background="{StaticResource SecondaryBackgroundBrush}">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Global Actions & Layout -->
                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                    <!-- Right: Port Management + Help -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="?" 
                                Click="HelpButton_Click"
                                Width="28" Height="26"
                                FontWeight="Bold"/>
                        <Button Content="+ Add Port" 
                                Command="{Binding AddPortCommand}" 
                                Width="90" Height="26"/>
                    </StackPanel>

                    <!-- Left: Batch Actions & Enter to send -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- 1. Connect All — play button, connects all configured ports -->
                        <Button Content="▶ Connect All"
                                Command="{Binding ConnectAllCommand}"
                                Width="105" Height="26"/>

                        <Border Width="1" Height="16" Background="{StaticResource BorderBrush}" Margin="8,0"/>

                        <!-- 2a. Log Start All -->
                        <Button Command="{Binding LogAllOnCommand}"
                                Width="80" Height="26">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="▶ Log All"/>
                                    <Setter Property="Background" Value="#143A2C"/>
                                    <Setter Property="Foreground" Value="#34D399"/>
                                    <Setter Property="BorderBrush" Value="#065F46"/>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 2b. Log Stop All -->
                        <Button Command="{Binding LogAllOffCommand}"
                                Width="80" Height="26"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="■ Log All"/>
                                    <Setter Property="Background" Value="#381E22"/>
                                    <Setter Property="Foreground" Value="#F87171"/>
                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Row 2: Global Log Settings -->
                <DockPanel Grid.Row="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Log Directory:" Style="{StaticResource HeaderLabel}"/>
                        <TextBox Text="{Binding LogDirectory}" 
                                 Width="300" Height="25" 
                                 VerticalAlignment="Center"/>
                        <Button Content="..." 
                                Command="{Binding BrowseLogDirectoryCommand}" 
                                Width="28" Height="25" 
                                Margin="2,0,0,0" Padding="0"/>
                        
                        <!-- 3. Open Log Directory Button -->
                        <Button Content="📁 Open Dir" 
                                Command="{Binding OpenLogDirectoryCommand}" 
                                Height="25" Padding="8,0" 
                                Margin="4,0,0,0"/>

                        <Border Width="1" Height="16" Background="{StaticResource BorderBrush}" Margin="12,0,6,0"/>

                        <TextBlock Text="File Template:" Style="{StaticResource HeaderLabel}"/>
                        <TextBox Text="{Binding LogFileNameTemplate}" 
                                 Width="180" Height="25" 
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══════════ GLOBAL STATUS BAR ═══════════ -->
        <Border DockPanel.Dock="Bottom" 
                Background="#0B101A" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="8,4">
            <DockPanel>
                <!-- Right: Global Badges -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Ports: " Foreground="{StaticResource MutedForegroundBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Ports.Count}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Global Logging: " Foreground="{StaticResource MutedForegroundBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding IsAllLogging, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=logging}" 
                                       FontWeight="SemiBold" FontSize="11" 
                                       Foreground="{Binding IsAllLogging, Converter={StaticResource BoolToColorConverter}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left: Status Message -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusBarText}" FontSize="11" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════ PORT MONITORS GRID ═══════════ -->
        <ItemsControl ItemsSource="{Binding Ports}" Margin="4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.LayoutColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                 Rows="{Binding DataContext.LayoutRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBackgroundBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Margin="3"
                            ClipToBounds="True">
                        <Grid>
                            <!-- ╔═════════════════════════════════════════╗ -->
                            <!-- ║  UNCONFIGURED STATE: Port Setup Card   ║ -->
                            <!-- ╚═════════════════════════════════════════╝ -->
                            <Border Visibility="{Binding IsConfigured, Converter={StaticResource InvBoolToVis}}"
                                    Background="{StaticResource PrimaryBackgroundBrush}">
                                <Border Background="#131921" 
                                        BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="10" 
                                        Padding="28,24" 
                                        Width="360" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <!-- Header Icon + Title -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#162032" Margin="0,0,8,0">
                                                <TextBlock Text="⚡" FontSize="14" Foreground="#539BF5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Configure Port" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryForegroundBrush}" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <TextBlock Text="Select a serial COM port and baud rate to monitor" 
                                                   FontSize="11" Foreground="{StaticResource MutedForegroundBrush}" 
                                                   HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                        <!-- Form: COM Port -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="COM Port" Style="{StaticResource FormLabel}"/>
                                            <ComboBox ItemsSource="{Binding AvailablePorts}" 
                                                      SelectedItem="{Binding SelectedPort}" 
                                                      Height="28"/>
                                        </DockPanel>

                                        <!-- Form: Baud Rate -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Baud Rate" Style="{StaticResource FormLabel}"/>
                                            <ComboBox ItemsSource="{Binding CommonBaudRates}" 
                                                      SelectedItem="{Binding SelectedBaudRate}" 
                                                      Height="28"/>
                                        </DockPanel>

                                        <!-- Form: Data Bits -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Data Bits" Style="{StaticResource FormLabel}"/>
                                            <ComboBox ItemsSource="{Binding DataBitsValues}"
                                                      SelectedItem="{Binding DataBits}"
                                                      Height="28"/>
                                        </DockPanel>

                                        <!-- Form: Parity -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Parity" Style="{StaticResource FormLabel}"/>
                                            <ComboBox ItemsSource="{Binding ParityValues}"
                                                      SelectedItem="{Binding SelectedParity}"
                                                      Height="28"/>
                                        </DockPanel>

                                        <!-- Form: Stop Bits -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Stop Bits" Style="{StaticResource FormLabel}"/>
                                            <ComboBox ItemsSource="{Binding StopBitsValues}"
                                                      SelectedItem="{Binding SelectedStopBits}"
                                                      Height="28"/>
                                        </DockPanel>

                                        <!-- Form: Handshake (Flow Control) -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Handshake" Style="{StaticResource FormLabel}"/>
                                            <ComboBox ItemsSource="{Binding HandshakeValues}"
                                                      SelectedItem="{Binding SelectedHandshake}"
                                                      Height="28"/>
                                        </DockPanel>

                                        <!-- Form: Memorable Name -->
                                        <DockPanel Margin="0,0,0,18">
                                            <TextBlock Text="Name" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="28"
                                                     VerticalContentAlignment="Center"
                                                     Padding="8,0"/>
                                        </DockPanel>

                                        <!-- Apply Button -->
                                        <Button Content="✓ Apply Configuration" 
                                                Command="{Binding ApplyConfigCommand}" 
                                                Style="{StaticResource AccentButton}"
                                                Height="32" 
                                                FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>
                            </Border>

                            <!-- ✕ Close button for unconfigured panel (top-right overlay) -->
                            <Button Command="{Binding RemoveThisPortCommand}"
                                    Style="{StaticResource ToolButton}"
                                    Content="✕"
                                    Width="22" Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,4,0"
                                    Foreground="{StaticResource MutedForegroundBrush}"
                                    Visibility="{Binding IsConfigured, Converter={StaticResource InvBoolToVis}}"/>

                            <!-- ╔═════════════════════════════════════════╗ -->
                            <!-- ║  CONFIGURED STATE: Monitor + Controls  ║ -->
                            <!-- ╚═════════════════════════════════════════╝ -->
                            <DockPanel Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
                                
                                <!-- ─── 1. Header Bar: Port Name + State + Reset ─── -->
                                <Border DockPanel.Dock="Top" 
                                        Background="#1C2333" 
                                        BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="8,5">
                                    <DockPanel>
                                        <!-- Right: Close (✕) and Reset (↺) Buttons -->
                                        <Button DockPanel.Dock="Right" 
                                                Content="✕" 
                                                Command="{Binding RemoveThisPortCommand}" 
                                                Style="{StaticResource ToolButton}"
                                                Width="22" Height="22" 
                                                Foreground="{StaticResource MutedForegroundBrush}"/>
                                        <Button DockPanel.Dock="Right" 
                                                Content="↺" 
                                                Command="{Binding ResetConfigCommand}" 
                                                Style="{StaticResource ToolButton}"
                                                Width="22" Height="22" 
                                                Foreground="{StaticResource MutedForegroundBrush}"/>

                                        <!-- Left: Indicator dot + Display Label -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" 
                                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DisplayLabel}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12"
                                                       Foreground="{StaticResource PrimaryForegroundBrush}" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ─── 2. Controls Toolbar ─── -->
                                <Border DockPanel.Dock="Top" 
                                        Background="{StaticResource SecondaryBackgroundBrush}" 
                                        BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="6,3">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Connect/Disconnect toggle: green=connected, red=disconnected -->
                                        <Button Command="{Binding ToggleConnectCommand}" 
                                                Width="90" Height="24" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Disconnected"/>
                                                    <Setter Property="Background" Value="#381E22"/>
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Content" Value="Connected"/>
                                                            <Setter Property="Background" Value="#143A2C"/>
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                            <Setter Property="BorderBrush" Value="#065F46"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                                        <!-- Log toggle: green=logging, red=not logging -->
                                        <Button Command="{Binding ToggleLogCommand}" 
                                                Width="50" Height="24" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Log"/>
                                                    <Setter Property="Background" Value="#381E22"/>
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLogging}" Value="True">
                                                            <Setter Property="Background" Value="#143A2C"/>
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                            <Setter Property="BorderBrush" Value="#065F46"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                                        <!-- Timestamp toggle: green=ON, red=OFF -->
                                        <Button Command="{Binding ToggleTimestampCommand}"
                                                Width="80" Height="24" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Timestamp"/>
                                                    <Setter Property="Background" Value="#381E22"/>
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowTimestamp}" Value="True">
                                                            <Setter Property="Background" Value="#143A2C"/>
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                            <Setter Property="BorderBrush" Value="#065F46"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- AutoScroll toggle: green=ON, red=OFF -->
                                        <Button Command="{Binding ToggleAutoScrollCommand}"
                                                Width="80" Height="24" FontSize="11" Margin="4,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="AutoScroll"/>
                                                    <Setter Property="Background" Value="#381E22"/>
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AutoScroll}" Value="True">
                                                            <Setter Property="Background" Value="#143A2C"/>
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                            <Setter Property="BorderBrush" Value="#065F46"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                                        <Button Content="Clear" 
                                                Command="{Binding ClearCommand}" 
                                                Width="55" Height="24" FontSize="11"/>

                                        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                                        <TextBlock Text="View:" Foreground="{StaticResource MutedForegroundBrush}" 
                                                   VerticalAlignment="Center" FontSize="10" Margin="2,0"/>
                                        <ComboBox ItemsSource="{Binding LogFormatValues}" 
                                                  SelectedItem="{Binding SelectedDisplayFormat}" 
                                                  Width="62" Height="24" FontSize="10" Padding="3,1"/>

                                        <TextBlock Text="Log:" Foreground="{StaticResource MutedForegroundBrush}" 
                                                   VerticalAlignment="Center" FontSize="10" Margin="4,0,2,0"/>
                                        <ComboBox ItemsSource="{Binding LogFormatValues}" 
                                                  SelectedItem="{Binding SelectedLogFormat}" 
                                                  Width="62" Height="24" FontSize="10" Padding="3,1"/>
                                    </WrapPanel>
                                </Border>

                                <!-- ─── 3. TX Transmit Bar ─── -->
                                <Border DockPanel.Dock="Bottom" 
                                        Background="#0D1117" 
                                        BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="0,1,0,0" 
                                        Padding="6,4">
                                    <DockPanel>
                                        <!-- Send icon button (far right) -->
                                        <Button DockPanel.Dock="Right" 
                                                Content="➤" 
                                                Command="{Binding SendCommand}" 
                                                Style="{StaticResource AccentButton}"
                                                Width="32" Height="24" FontSize="13" Margin="4,0,0,0"/>

                                        <ComboBox DockPanel.Dock="Right" 
                                                  ItemsSource="{Binding LineEndingOptions}" 
                                                  SelectedItem="{Binding SelectedLineEnding}" 
                                                  Width="60" Height="24" FontSize="10" Padding="3,1" Margin="3,0"/>
                                        
                                        <ComboBox DockPanel.Dock="Right" 
                                                  ItemsSource="{Binding TxModeOptions}"
                                                  SelectedItem="{Binding TxMode}"
                                                  Width="65" Height="24" FontSize="10" Padding="3,1" Margin="4,0,4,0"/>

                                        <Border DockPanel.Dock="Left" 
                                                Background="#162032" 
                                                BorderBrush="#22303E" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="5,2" 
                                                Margin="0,0,6,0">
                                            <TextBlock Text="TX" Foreground="#539BF5" FontWeight="Bold" FontSize="10"/>
                                        </Border>

                                        <TextBox Text="{Binding TxInput, UpdateSourceTrigger=PropertyChanged}" 
                                                 PreviewKeyDown="TxTextBox_PreviewKeyDown"
                                                 FontFamily="Consolas, Cascadia Code, Courier New" 
                                                 FontSize="11" 
                                                 Height="26" 
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Padding="6,0"/>
                                    </DockPanel>
                                </Border>

                                <!-- ─── 4. Metrics & Status Bar ─── -->
                                <Border DockPanel.Dock="Bottom" 
                                        Background="#0B101A" 
                                        BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="0,1,0,0" 
                                        Padding="6,3">
                                    <DockPanel>
                                        <!-- Right: Numeric Byte Counters -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource MetricPill}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="RX: " Foreground="#57AB5A" FontSize="10" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BytesReceived, StringFormat={}{0:N0} B}" FontSize="10" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricPill}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="TX: " Foreground="#539BF5" FontSize="10" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BytesSent, StringFormat={}{0:N0} B}" FontSize="10" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricPill}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="LOG: " Foreground="#8B7CF6" FontSize="10" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BytesLogged, StringFormat={}{0:N0} B}" FontSize="10" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Left: Connection Status -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" 
                                                       FontSize="10" 
                                                       FontWeight="Medium"
                                                       Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ─── 5. High-Performance Monospace Terminal Monitor ─── -->
                                <ListBox ItemsSource="{Binding MonitorLines}" 
                                         Background="{StaticResource TerminalBackgroundBrush}" 
                                         Foreground="#CDD9E5"
                                         FontFamily="Consolas, Cascadia Code, Courier New" 
                                         FontSize="11"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         BorderThickness="0"
                                         Padding="4,2"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.ScrollChanged="MonitorListBox_ScrollChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" LineHeight="15"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
