<Window x:Class="EverLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:EverLogger.App.Helpers"
        Title="EverLogger - Serial Monitor &amp; Logger" Height="750" Width="1100"
        MinWidth="800" MinHeight="600"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource PrimaryForegroundBrush}">
    
    <Window.Resources>
        <helpers:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <helpers:BoolToColorConverter x:Key="BoolToColorConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,2,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════ GENERAL CONFIG TOOLBAR ═══════════ -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SecondaryBackgroundBrush}">
            <StackPanel Orientation="Vertical" Margin="5,4">
                <!-- Row 1: Port management + Global actions -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <Button Content="⟳ Rescan" Command="{Binding RefreshPortsCommand}"/>
                    <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedNewPort}" Width="230"/>
                    <ComboBox ItemsSource="{Binding CommonBaudRates}" SelectedItem="{Binding SelectedBaudRate}" Width="90"/>
                    <Button Content="+ Add" Command="{Binding AddPortCommand}"/>
                    <Button Content="− Remove" Command="{Binding RemovePortCommand}"/>
                    <Separator Width="15" Visibility="Hidden"/>
                    
                    <Button Content="▶ Connect All" Command="{Binding ConnectAllCommand}"/>
                    <Button Content="■ Disconnect All" Command="{Binding DisconnectAllCommand}"/>
                    <Separator Width="15" Visibility="Hidden"/>
                    <Button Content="⏺ Log All ON" Command="{Binding LogAllOnCommand}"/>
                    <Button Content="⏹ Log All OFF" Command="{Binding LogAllOffCommand}"/>
                </StackPanel>

                <!-- Row 2: Log settings + Layout -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Log Dir:" Style="{StaticResource SmallLabel}"/>
                    <TextBox Text="{Binding LogDirectory}" Width="250" VerticalAlignment="Center"/>
                    <Button Content="..." Command="{Binding BrowseLogDirectoryCommand}" Padding="6,3"/>
                    <TextBlock Text="File Name:" Style="{StaticResource SmallLabel}" Margin="12,0,2,0"/>
                    <TextBox Text="{Binding LogFileNameTemplate}" Width="140" VerticalAlignment="Center"/>
                    <TextBlock Text="Layout:" Style="{StaticResource SmallLabel}" Margin="12,0,2,0"/>
                    <ComboBox ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding SelectedLayout}" Width="60"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════ STATUS BAR ═══════════ -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource AccentBrush}" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ports: " FontSize="11"/>
                    <TextBlock Text="{Binding Ports.Count}" FontSize="11"/>
                    <TextBlock Text=" | Logging: " FontSize="11" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding IsAllLogging, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=logging}" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══════════ PORT MONITORS GRID ═══════════ -->
        <ItemsControl ItemsSource="{Binding Ports}" Margin="3">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.LayoutColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                 Rows="{Binding DataContext.LayoutRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="2" CornerRadius="3">
                        <DockPanel>
                            <!-- ─── Port Header: Name + Description ─── -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource TertiaryBackgroundBrush}" Padding="6,3">
                                <DockPanel>
                                    <Ellipse Width="10" Height="10" 
                                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" 
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- ─── Per-Port Controls ─── -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource SecondaryBackgroundBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,3">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Connect" Command="{Binding ConnectCommand}" Padding="6,2" FontSize="10"/>
                                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="6,2" FontSize="10"/>
                                    <Separator Width="8" Visibility="Hidden"/>
                                    <Button Content="{Binding LogButtonText}" Command="{Binding ToggleLogCommand}" Padding="6,2" FontSize="10"/>
                                    <Separator Width="8" Visibility="Hidden"/>
                                    <TextBlock Text="Display:" Foreground="{StaticResource PrimaryForegroundBrush}" 
                                               VerticalAlignment="Center" FontSize="10" Margin="2,0"/>
                                    <ComboBox ItemsSource="{Binding LogFormatValues}" SelectedItem="{Binding SelectedDisplayFormat}" 
                                              Width="60" FontSize="10" Padding="2,1"/>
                                    <TextBlock Text="Log:" Foreground="{StaticResource PrimaryForegroundBrush}" 
                                               VerticalAlignment="Center" FontSize="10" Margin="4,0,2,0"/>
                                    <ComboBox ItemsSource="{Binding LogFormatValues}" SelectedItem="{Binding SelectedLogFormat}" 
                                              Width="60" FontSize="10" Padding="2,1"/>
                                    <Separator Width="6" Visibility="Hidden"/>
                                    <CheckBox Content="Auto↓" IsChecked="{Binding AutoScroll}" 
                                              Foreground="{StaticResource PrimaryForegroundBrush}" 
                                              VerticalAlignment="Center" FontSize="10" Margin="2,0"/>
                                    <Button Content="Clear" Command="{Binding ClearCommand}" Padding="6,2" FontSize="10"/>
                                </WrapPanel>
                            </Border>

                            <!-- ─── Port Status Bar ─── -->
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" 
                                    Padding="6,2" Background="{StaticResource SecondaryBackgroundBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                               Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                                    <TextBlock Text=" │ RX: " Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding BytesReceived}" Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10"/>
                                    <TextBlock Text=" │ Logged: " Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding BytesLogged}" Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <!-- ─── Monitor Output ─── -->
                            <ListBox ItemsSource="{Binding MonitorLines}" 
                                     Background="{StaticResource PrimaryBackgroundBrush}" 
                                     Foreground="{StaticResource PrimaryForegroundBrush}"
                                     FontFamily="Consolas" FontSize="11"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.ScrollChanged="MonitorListBox_ScrollChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
