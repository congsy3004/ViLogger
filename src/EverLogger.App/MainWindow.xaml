<Window x:Class="EverLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:EverLogger.App.Helpers"
        Title="EverLogger - Serial Monitor &amp; Logger" Height="750" Width="1100"
        MinWidth="800" MinHeight="600"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource PrimaryForegroundBrush}">
    
    <Window.Resources>
        <helpers:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <helpers:BoolToColorConverter x:Key="BoolToColorConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SecondaryBackgroundBrush}">
            <StackPanel Orientation="Vertical" Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="Refresh" Command="{Binding RefreshPortsCommand}"/>
                    <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedNewPort}" Width="220"/>
                    <ComboBox ItemsSource="{Binding CommonBaudRates}" SelectedItem="{Binding SelectedBaudRate}" Width="100"/>
                    <Button Content="Add Port" Command="{Binding AddPortCommand}"/>
                    <Button Content="Remove Port" Command="{Binding RemovePortCommand}"/>
                    <Separator Width="10" Visibility="Hidden"/>
                    
                    <Button Content="Connect All" Command="{Binding ConnectAllCommand}"/>
                    <Button Content="Disconnect All" Command="{Binding DisconnectAllCommand}"/>
                    <Separator Width="10" Visibility="Hidden"/>

                    <Button Content="Start Log" Command="{Binding StartLoggingCommand}"/>
                    <Button Content="Stop Log" Command="{Binding StopLoggingCommand}"/>
                    <Label Content="Display:" Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding LogFormatValues}" SelectedItem="{Binding SelectedLogFormat}" Width="80"/>
                    <Label Content="Log As:" Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding LogFormatValues}" SelectedItem="{Binding SelectedFileLogFormat}" Width="80"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Log Dir:" Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding LogDirectory}" Width="250" VerticalAlignment="Center"/>
                    <Button Content="..." Command="{Binding BrowseLogDirectoryCommand}"/>
                    <Label Content="File Template:" Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Text="{Binding LogFileNameTemplate}" Width="150" VerticalAlignment="Center"/>
                    <Label Content="Layout:" Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ComboBox ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding SelectedLayout}" Width="65"/>
                    <CheckBox Content="AutoScroll" IsChecked="{Binding AutoScroll}" Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource AccentBrush}" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ports: "/>
                    <TextBlock Text="{Binding Ports.Count}"/>
                    <TextBlock Text=" | Logging: " Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding IsAllLogging, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=logging}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Port Monitors Grid -->
        <ItemsControl ItemsSource="{Binding Ports}" Margin="5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.LayoutColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                 Rows="{Binding DataContext.LayoutRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="2" CornerRadius="3">
                        <DockPanel>
                            <!-- Port Header -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource TertiaryBackgroundBrush}" Padding="8,4">
                                <DockPanel>
                                    <Ellipse Width="10" Height="10" Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" 
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Port Status Bar -->
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="5,3" Background="{StaticResource SecondaryBackgroundBrush}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Padding="8,2" FontSize="10"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                   Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                                        <TextBlock Text=" | RX: " Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding BytesReceived}" Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10"/>
                                        <TextBlock Text=" | Logged: " Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding BytesLogged}" Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="10"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Monitor -->
                            <ListBox ItemsSource="{Binding MonitorLines}" 
                                     Background="{StaticResource PrimaryBackgroundBrush}" 
                                     Foreground="{StaticResource PrimaryForegroundBrush}"
                                     FontFamily="Consolas" FontSize="11"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.ScrollChanged="MonitorListBox_ScrollChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
